{
    "name": "airi-lab",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "start": "vite --port 3000",
        "dev": "vite --port 3000",
        "build": "npm run test && vite build",
        "preview": "vite preview",
        "test": "npm run test:types && npm run test:contracts",
        "test:types": "tsc -p tsconfig.app.json --noEmit --pretty false && tsc -p tsconfig.node.json --noEmit --pretty false",
        "test:contracts": "node --test tests/generation-workflows.test.mjs tests/display-server.test.mjs tests/display-diagnostics.test.mjs tests/display-package.test.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "package:display": "npm run build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/package-display.ps1"
    },
    "dependencies": {
        "i18next": "^26.4.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-i18next": "^17.0.12",
        "react-router-dom": "^7.18.3"
    },
    "devDependencies": {
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@vitejs/plugin-react": "^6.1.1",
        "prettier": "^3.9.6",
        "sass": "^1.103.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.2"
    }
}
